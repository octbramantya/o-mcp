# Connection for tools/migrate.sh. Copy to .env (gitignored) and fill in.
# Every key is required; there are no defaults.
#
# .env is the DEVELOPMENT database: a restored copy of valkyrie, superuser allowed.
# Production files are created for one session and deleted afterwards:
#   .env.prod-ro  read-only (grafReader), the source for tools/dev_refresh.sh -s
#   .env.prod     write credentials, for tools/migrate.sh -e .env.prod apply ...

# Shown on every run, and what --confirm must repeat. Use "dev" or "prod".
DB_LABEL=dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=valkyrie-dev
DB_USER=postgres
DB_PASSWORD=
