# Connection for tools/migrate.sh. Copy to .env (gitignored) and fill in.
# Every key is required; there are no defaults.
#
# .env is the DEVELOPMENT database: a restored copy of valkyrie, superuser allowed.
# Production files are created for one session and deleted afterwards:
#   .env.prod-ro  read-only (grafReader), the source for tools/dev_refresh.sh -s
#   .env.prod     write credentials, for tools/migrate.sh -e .env.prod apply ...

# Shown on every run, and what --confirm must repeat. Use "dev" or "prod".
DB_LABEL=dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=valkyrie-dev
DB_USER=postgres
DB_PASSWORD=

# TLS, read by the MCP server (tools/*.sh ignore it). libpq's sslmode. Outside dev it must be
# verify-ca or verify-full, with DB_SSLROOTCERT naming the certificate to trust; in production
# PgBouncer's own, pinned at /etc/o-mcp/pgbouncer-ca.pem (design/mcp-server.md §7).
DB_SSLMODE=require
# DB_SSLROOTCERT=

# The MCP server (python -m server) also needs these; none has a default. They may live here or in
# the process environment. In production they are in /etc/o-mcp/env (design/mcp-server.md §6).
#   O_MCP_TOKEN   bearer token clients send; at least 32 characters
#   O_MCP_BIND    host:port to listen on, e.g. 127.0.0.1:8080
#   O_MCP_TENANT  the tenant the tools describe, e.g. 3
#   O_MCP_TZ      the site's IANA time zone, e.g. Asia/Jakarta (the database's own functions assume it)

# The frontend's API (python -m api) reads DB_LABEL, DB_HOST, DB_PORT, DB_NAME and DB_SSLMODE above,
# never DB_USER or DB_PASSWORD, and these; none has a default:
#   O_API_DB_USER      frontend_api (migration 061); LOGIN and its password are set by hand
#   O_API_DB_PASSWORD  its password
#   O_API_BIND         host:port to listen on, e.g. 127.0.0.1:8770
#   O_API_TENANT_<id>_PASSWORD  the password of each active tenant's role in frontend.tenant
#                      (O_API_TENANT_3_PASSWORD for prs_frontend); LOGIN set by hand, as above
